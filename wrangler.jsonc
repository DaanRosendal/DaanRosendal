{
  "name": "daanrosendal",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the chat API runs the Worker. Every other request is a static asset, which is free and unlimited.
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": false,
  "vars": { "CHAT_ENABLED": "1" },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  // The saved chats (schema in migrations/). The database is in the EU jurisdiction, which cannot be changed afterwards.
  // Migrations are applied by hand: npx wrangler d1 migrations apply daanrosendal-chats --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "daanrosendal-chats", "database_id": "782ace6a-c698-44a8-b70a-611bd8f6032d", "migrations_dir": "migrations" }
  ],
  // Every day at 03:17 UTC: chats older than 90 days lose the columns that point to a person (src/worker/log.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
