{
  "name": "daanrosendal",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the chat API runs the Worker. Every other request is a static asset, which is free and unlimited.
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": false,
  "vars": { "CHAT_ENABLED": "1" },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  // The saved chats (schema in migrations/). The id below is a placeholder for local runs: create the real database in the
  // EU (`npx wrangler d1 create daanrosendal-chats --jurisdiction eu`), put its id here, and apply the migrations with --remote.
  "d1_databases": [
    { "binding": "DB", "database_name": "daanrosendal-chats", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Every day at 03:17 UTC: chats older than 90 days lose the columns that point to a person (src/worker/log.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
