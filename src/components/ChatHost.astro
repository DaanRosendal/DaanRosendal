---
import { ArrowUp, Maximize2, Minimize2, X } from '@lucide/astro';
---

<!-- The chat's static shell. The whole chat is driven by html[data-chat] (open, full, dock; absent means closed), which an
     inline script in Layout sets before the first paint, so a minimised chat is already in place when a new page appears.
     The conversation itself (src/scripts/chat.ts) is fetched only when the chat is used or restored. -->
<div class="chat-pill-wrap">
  <form class="chat-pill" autocomplete="off">
    <img class="chat-avatar" src="/media/cat/junior-avatar.webp" alt="" width="32" height="32" decoding="async" />
    <input class="chat-pill-input" type="text" name="q" maxlength="600" placeholder="Ask Junior about Daan" aria-label="Ask Junior about Daan" enterkeyhint="send" />
    <button type="submit" class="chat-pill-go" aria-label="Send"><ArrowUp size={16} aria-hidden="true" /></button>
  </form>
  <button type="button" class="chat-pill-x" data-chat-act="dismiss" aria-label="Hide the chat box">
    <X size={12} aria-hidden="true" />
  </button>
</div>

<section id="chat" class="chat" role="dialog" aria-label="Chat with Junior">
  <header class="chat-head">
    <img class="chat-avatar" src="/media/cat/junior-avatar.webp" alt="" width="32" height="32" loading="lazy" decoding="async" />
    <h2 class="chat-title">Junior</h2>
    <button type="button" class="chat-btn chat-btn-expand" data-chat-act="expand" aria-label="Expand the chat"><Maximize2 size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn chat-btn-min" data-chat-act="minimise" aria-label="Minimise the chat"><Minimize2 size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn" data-chat-act="close" aria-label="Close the chat"><X size={16} aria-hidden="true" /></button>
  </header>
  <div class="chat-body"></div>
</section>

<noscript><style>.chat-pill-wrap,.chat-revive{display:none!important}</style></noscript>

<script>
  const root = document.documentElement;
  let chat: Promise<typeof import('../scripts/chat')> | undefined;
  const load = () => (chat ??= import('../scripts/chat'));
  const OFF_KEY = 'chat:off';

  const pill = document.querySelector<HTMLFormElement>('.chat-pill')!;
  const field = pill.querySelector<HTMLInputElement>('input')!;
  pill.addEventListener('pointerenter', load, { once: true });
  field.addEventListener('focus', load, { once: true });
  // Enter sends the question and the chat takes over the screen.
  pill.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = field.value.trim();
    if (!text) return;
    field.value = '';
    field.blur();
    load().then((chat) => chat.send(text));
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const button = target.closest<HTMLElement>('[data-chat-act]');
    const act = button?.dataset.chatAct ?? (root.dataset.chat === 'dock' && target.closest('.chat-head') ? 'expand' : '');
    if (!act) return;
    if (act === 'dismiss') {
      try {
        localStorage.setItem(OFF_KEY, String(Date.now()));
      } catch {}
      root.dataset.off = '';
      return;
    }
    if (act === 'revive') {
      try {
        localStorage.removeItem(OFF_KEY);
      } catch {}
      delete root.dataset.off;
      requestAnimationFrame(() => field.focus());
      return;
    }
    load().then((chat) => chat.act(act));
  });

  // A minimised chat from the previous page: bring its conversation back.
  if (root.dataset.chat) load();

  // Back or forward through the browser's cache can show a page frozen in an older chat state.
  addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    let mode: string | undefined;
    try {
      mode = JSON.parse(sessionStorage.getItem('chat:v1') ?? 'null')?.mode;
    } catch {}
    if (mode === 'dock') root.dataset.chat = 'dock';
    else delete root.dataset.chat;
    if (chat || mode === 'dock') load().then((chat) => chat.sync());
  });
</script>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.15s;
  }
  html[data-chat='dock'] .chat {
    view-transition-name: chat;
  }

  .chat,
  .chat-pill-wrap {
    --c-bg: #fff;
    --c-fg: #111827;
    --c-muted: #4b5563;
    --c-line: #d1d5db;
    --c-bubble: #f3f4f6;
    --ease: cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  @media (prefers-color-scheme: dark) {
    .chat,
    .chat-pill-wrap {
      --c-bg: #171717;
      --c-fg: #fff;
      --c-muted: #a3a3a3;
      --c-line: #404040;
      --c-bubble: #262626;
    }
  }

  .chat {
    position: fixed;
    z-index: 60;
    display: none;
    flex-direction: column;
    overflow: hidden;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    background: var(--c-bg);
    color: var(--c-fg);
    border: 1px solid var(--c-line);
    border-radius: 1rem;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.14);
    transition:
      left 0.55s var(--ease),
      top 0.55s var(--ease),
      width 0.55s var(--ease),
      height 0.55s var(--ease),
      border-radius 0.55s var(--ease);
  }
  html[data-chat] .chat {
    display: flex;
  }
  html[data-chat='dock'] .chat {
    --w: min(23rem, calc(100% - 2rem));
    --h: min(30rem, calc(100dvh - 2rem));
    --x: calc(100% - var(--w) - 1rem);
    --y: calc(100dvh - var(--h) - 1rem);
  }
  html[data-chat='full'] .chat {
    --c-bg: transparent;
    --w: 100%;
    --h: 100dvh;
    --x: 0px;
    --y: 0px;
    border-radius: 0;
    border-color: transparent;
    box-shadow: none;
  }
  @media (max-width: 40rem) {
    html[data-chat='dock'] .chat {
      --w: calc(100% - 1.5rem);
      --h: 3.25rem;
      --x: 0.75rem;
      --y: calc(100dvh - 3.25rem - 0.75rem);
    }
    html[data-chat='dock'] .chat-body {
      display: none;
    }
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex: none;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    min-height: 3.25rem;
  }
  html[data-chat='dock'] .chat-head {
    cursor: pointer;
  }
  .chat-avatar {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .chat-head .chat-avatar {
    margin-right: 0.6rem;
  }
  .chat-title {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .chat-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--c-muted);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .chat-btn:hover {
    background: var(--c-bubble);
    color: var(--c-fg);
  }
  .chat-btn-expand,
  .chat-btn-min {
    display: none;
  }
  html[data-chat='dock'] .chat-btn-expand,
  html[data-chat='full'] .chat-btn-min {
    display: grid;
  }
  .chat-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .chat :focus-visible,
  .chat-pill-x:focus-visible {
    outline: 2px solid var(--c-muted);
    outline-offset: 2px;
  }

  .chat-pill-wrap {
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    width: min(22rem, calc(100% - 2rem));
    opacity: 0;
    pointer-events: none;
    animation: chat-fade 0.6s ease 1.5s forwards;
  }
  html[data-chat] .chat-pill-wrap,
  html[data-off] .chat-pill-wrap {
    display: none;
  }
  @keyframes chat-fade {
    to {
      opacity: 1;
      pointer-events: auto;
    }
  }
  .chat-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.35rem 0.3rem 0.3rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-bg);
    color: var(--c-muted);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.1);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .chat-pill:hover,
  .chat-pill:focus-within {
    border-color: var(--c-muted);
    box-shadow: 0 6px 22px rgb(0 0 0 / 0.14);
  }
  .chat-pill-input {
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--c-fg);
    font: inherit;
    font-size: 1rem;
  }
  .chat-pill-input::placeholder {
    color: var(--c-muted);
  }
  .chat-pill-go {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--c-fg);
    color: var(--c-bg);
    cursor: pointer;
    opacity: 0;
    scale: 0.8;
    transition:
      opacity 0.15s,
      scale 0.15s;
  }
  .chat-pill:has(.chat-pill-input:not(:placeholder-shown)) .chat-pill-go {
    opacity: 1;
    scale: 1;
  }
  .chat-pill-x {
    position: absolute;
    right: -0.3rem;
    bottom: -0.55rem;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    background: var(--c-bg);
    color: var(--c-muted);
    cursor: pointer;
  }
  .chat-pill-x:hover {
    color: var(--c-fg);
    border-color: var(--c-muted);
  }
  .chat-revive {
    display: none;
  }
  html[data-off]:not([data-chat]) .chat-revive {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .chat,
    .chat-pill {
      transition: none;
    }
  }
  @media (forced-colors: active) {
    .chat,
    .chat-pill,
    .chat-pill-x {
      border: 1px solid CanvasText;
      background: Canvas;
      color: CanvasText;
    }
  }
</style>
