---
import { ArrowUp, Maximize2, Minimize2, RotateCcw, X } from '@lucide/astro';
---

<!-- The chat's static shell. The whole chat is driven by html[data-chat] (open, full, dock; absent means closed), which an
     inline script in Layout sets before the first paint, so a minimised chat is already in place when a new page appears.
     The conversation itself (src/scripts/chat.ts) is fetched only when the chat is used or restored. -->
<div class="chat-pill-wrap">
  <form class="chat-pill" autocomplete="off">
    <img class="chat-avatar" src="/media/cat/junior-clean.webp" alt="" width="32" height="32" decoding="async" />
    <textarea class="chat-pill-input" name="q" rows="1" maxlength="600" placeholder="Ask Junior about Daan" aria-label="Ask Junior about Daan" enterkeyhint="send"></textarea>
    <button type="submit" class="chat-pill-go" aria-label="Send"><ArrowUp size={16} aria-hidden="true" /></button>
  </form>
  <button type="button" class="chat-pill-x" data-chat-act="dismiss" aria-label="Hide the chat box">
    <X size={12} aria-hidden="true" />
  </button>
</div>

<section id="chat" class="chat" role="dialog" aria-label="Chat with Junior">
  <header class="chat-head">
    <img class="chat-avatar" src="/media/cat/junior-clean.webp" alt="" width="32" height="32" loading="lazy" decoding="async" />
    <h2 class="chat-title">Junior</h2>
    <button type="button" class="chat-btn chat-btn-reset" data-chat-act="reset" aria-label="Reset the chat position and size" title="Reset position and size"><RotateCcw size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn chat-btn-expand" data-chat-act="expand" aria-label="Expand the chat"><Maximize2 size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn chat-btn-min" data-chat-act="minimise" aria-label="Minimise the chat"><Minimize2 size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn" data-chat-act="close" aria-label="Close the chat"><X size={16} aria-hidden="true" /></button>
  </header>
  <div class="chat-body"></div>
</section>

<noscript><style>.chat-pill-wrap,.chat-revive{display:none!important}</style></noscript>

<script>
  const root = document.documentElement;
  let chat: Promise<typeof import('../scripts/chat')> | undefined;
  const load = () => (chat ??= import('../scripts/chat'));
  const OFF_KEY = 'chat:off';

  const pill = document.querySelector<HTMLFormElement>('.chat-pill')!;
  const field = pill.querySelector<HTMLTextAreaElement>('textarea')!;
  pill.addEventListener('pointerenter', load, { once: true });
  field.addEventListener('focus', load, { once: true });
  // Shift+Enter adds a line break and the box grows upward (the pill is anchored at the bottom), up to about five lines.
  const grow = () => {
    field.style.height = 'auto';
    field.style.height = `${Math.min(field.scrollHeight, 128)}px`;
    field.style.overflowY = field.scrollHeight > 128 ? 'auto' : 'hidden';
    pill.toggleAttribute('data-multi', field.scrollHeight > 32);
  };
  field.addEventListener('input', grow);
  field.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
      event.preventDefault();
      pill.requestSubmit();
    }
  });
  // Enter sends the question and the chat takes over the screen.
  pill.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = field.value.trim();
    if (!text) return;
    field.value = '';
    grow();
    field.blur();
    load().then((chat) => chat.send(text));
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const button = target.closest<HTMLElement>('[data-chat-act]');
    const act = button?.dataset.chatAct ?? (root.dataset.chat === 'dock' && target.closest('.chat-head') ? 'expand' : '');
    if (!act) return;
    if (act === 'dismiss') {
      try {
        localStorage.setItem(OFF_KEY, String(Date.now()));
      } catch {}
      root.dataset.off = '';
      return;
    }
    if (act === 'revive') {
      try {
        localStorage.removeItem(OFF_KEY);
      } catch {}
      delete root.dataset.off;
      requestAnimationFrame(() => field.focus());
      return;
    }
    load().then((chat) => chat.act(act));
  });

  // A minimised chat from the previous page: bring its conversation back.
  if (root.dataset.chat) load();

  // Back or forward through the browser's cache can show a page frozen in an older chat state.
  addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    let mode: string | undefined;
    try {
      mode = JSON.parse(sessionStorage.getItem('chat:v1') ?? 'null')?.mode;
    } catch {}
    if (mode === 'dock') root.dataset.chat = 'dock';
    else delete root.dataset.chat;
    if (chat || mode === 'dock') load().then((chat) => chat.sync());
  });
</script>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.15s;
  }
  html[data-chat='dock'] .chat {
    view-transition-name: chat;
  }

  /* The dock's box, shared by the window and the water's clip (chat.css). --s-r, --s-b, --s-w and --s-h are the visitor's
     saved distance from the right and bottom edge and size in px (set by the head script in Layout and by dock.ts). They
     are only clamped here, never rewritten: a window shrunk and enlarged again returns to the saved place. */
  html {
    --dock-w: min(max(var(--s-w, 23rem), 21rem), 100% - 1rem);
    --dock-h: min(max(var(--s-h, 30rem), 20rem), 100dvh - 1rem);
    --dock-r: clamp(0.5rem, var(--s-r, 1rem), calc(100% - var(--dock-w) - 0.5rem));
    --dock-b: clamp(0.5rem, var(--s-b, 1rem), calc(100dvh - var(--dock-h) - 0.5rem));
  }

  .chat,
  .chat-pill-wrap {
    --c-bg: #fff;
    /* Text on a --c-fg button: the window color, which --c-bg no longer is in full screen (there it is transparent). */
    --c-on-fg: #fff;
    --c-fg: #111827;
    --c-muted: #4b5563;
    --c-line: #d1d5db;
    --c-bubble: #f3f4f6;
    --ease: cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  @media (prefers-color-scheme: dark) {
    .chat,
    .chat-pill-wrap {
      --c-bg: #171717;
      --c-on-fg: #171717;
      --c-fg: #fff;
      --c-muted: #a3a3a3;
      --c-line: #404040;
      --c-bubble: #262626;
    }
  }

  .chat {
    position: fixed;
    z-index: 60;
    display: none;
    flex-direction: column;
    overflow: hidden;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    background: var(--c-bg);
    color: var(--c-fg);
    border: 1px solid var(--c-line);
    border-radius: 1rem;
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.08),
      0 16px 40px rgb(0 0 0 / 0.16);
    transition:
      left 0.45s var(--ease),
      top 0.45s var(--ease),
      width 0.45s var(--ease),
      height 0.45s var(--ease),
      border-radius 0.45s var(--ease),
      background-color 0.4s ease;
  }
  html[data-chat] .chat {
    display: flex;
  }
  html[data-chat='dock'] .chat {
    --w: var(--dock-w);
    --h: var(--dock-h);
    --x: calc(100% - var(--w) - var(--dock-r));
    --y: calc(100dvh - var(--h) - var(--dock-b));
  }
  html[data-chat='full'] .chat {
    --c-bg: transparent;
    --w: 100%;
    --h: 100dvh;
    --x: 0px;
    --y: 0px;
    border-radius: 0;
    border-color: transparent;
    box-shadow: none;
  }
  @media (max-width: 40rem) {
    html[data-chat='dock'] .chat {
      --w: calc(100% - 1.5rem);
      --h: 3.25rem;
      --x: 0.75rem;
      --y: calc(100dvh - 3.25rem - 0.75rem);
    }
    html[data-chat='dock'] .chat-body {
      display: none;
    }
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex: none;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    min-height: 3.25rem;
  }
  html[data-chat='dock'] .chat-head {
    cursor: pointer;
  }
  .chat-avatar {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .chat-head .chat-avatar {
    margin-right: 0.6rem;
  }
  .chat-title {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .chat-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--c-muted);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .chat-btn:hover {
    background: var(--c-bubble);
    color: var(--c-fg);
  }
  /* While the water moves, the text waits: it fades out fast and comes back once the water has settled. */
  .chat-head,
  .chat-body {
    transition: opacity 0.3s ease;
  }
  .chat-moving .chat-head,
  .chat-moving .chat-body {
    opacity: 0;
    transition-duration: 0.12s;
  }
  .chat-btn-expand,
  .chat-btn-min,
  .chat-btn-reset {
    display: none;
  }
  @media (min-width: 40.0625rem) {
    html[data-chat='dock'][data-dock-custom] .chat-btn-reset {
      display: grid;
    }
  }
  html[data-chat='dock'] .chat-btn-expand,
  html[data-chat='full'] .chat-btn-min {
    display: grid;
  }
  .chat-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .chat :focus-visible,
  .chat-pill-x:focus-visible {
    outline: 2px solid var(--c-muted);
    outline-offset: 2px;
  }

  .chat-pill-wrap {
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    width: min(32rem, calc(100% - 2rem));
    opacity: 0;
    pointer-events: none;
    animation:
      chat-fade 0.4s ease 0.5s forwards,
      chat-float 6s ease-in-out 0.9s infinite;
  }
  .chat-pill-wrap:hover,
  .chat-pill-wrap:focus-within {
    animation-play-state: running, paused;
  }
  html[data-off] .chat-pill-wrap {
    display: none;
  }
  html[data-chat] .chat-pill-wrap {
    opacity: 0 !important;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      visibility 0s 0.2s;
  }
  /* A slow, small bob so the pill and the minimised chat feel afloat. It stops while the pointer is over them or they
     have focus, while the dock is dragged, and with reduced motion. */
  @keyframes chat-float {
    50% {
      transform: translateY(-3px);
    }
  }
  @keyframes chat-float-dock {
    50% {
      translate: 0 -3px;
    }
  }
  html[data-chat='dock'] .chat {
    animation: chat-float-dock 7s ease-in-out infinite;
  }
  html[data-chat='dock'] .chat:hover,
  html[data-chat='dock'] .chat:focus-within,
  html.chat-dragging .chat {
    animation-play-state: paused;
  }
  @keyframes chat-fade {
    to {
      opacity: 1;
      pointer-events: auto;
    }
  }
  .chat-pill {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    /* The same gap all around the 2rem avatar and the send button, so they sit concentric in the pill's round ends (0.45rem + 2rem + 0.45rem is the old pill's height). */
    padding: 0.45rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-bg);
    color: var(--c-muted);
    box-shadow:
      0 1px 3px rgb(0 0 0 / 0.07),
      0 8px 24px rgb(0 0 0 / 0.12);
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      border-radius 0.15s;
  }
  .chat-pill[data-multi] {
    border-radius: 1.4rem;
  }
  .chat-pill:hover,
  .chat-pill:focus-within {
    border-color: var(--c-muted);
    box-shadow:
      0 2px 5px rgb(0 0 0 / 0.08),
      0 14px 32px rgb(0 0 0 / 0.16);
  }
  .chat-pill:focus-within {
    border-color: var(--c-fg);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--c-fg) 14%, transparent),
      0 14px 32px rgb(0 0 0 / 0.16);
    outline: 2px solid transparent;
    outline-offset: 3px;
  }
  .chat-pill-input {
    flex: 1;
    min-width: 0;
    /* One line is exactly as tall as the 2rem avatar, so the pill keeps its height. */
    padding: 0.3rem 0;
    max-height: 8rem;
    resize: none;
    overflow-y: hidden;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--c-fg);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4rem;
  }
  .chat-pill-input::placeholder {
    color: var(--c-muted);
  }
  .chat-pill-go {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--c-fg);
    color: var(--c-bg);
    cursor: pointer;
    opacity: 0;
    scale: 0.8;
    transition:
      opacity 0.15s,
      scale 0.15s;
  }
  .chat-pill:has(.chat-pill-input:not(:placeholder-shown)) .chat-pill-go {
    opacity: 1;
    scale: 1;
  }
  .chat-pill-x {
    position: absolute;
    right: -0.3rem;
    bottom: -0.55rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    background: var(--c-bg);
    color: var(--c-muted);
    cursor: pointer;
  }
  /* A bigger target than the 24px circle, growing outward only so it never covers the send button. */
  .chat-pill-x::after {
    content: '';
    position: absolute;
    inset: -0.4rem -0.4rem -0.4rem 0;
  }
  .chat-pill-x:hover {
    color: var(--c-fg);
    border-color: var(--c-muted);
  }
  .chat-revive {
    display: none;
  }
  html[data-off]:not([data-chat]) .chat-revive {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .chat,
    .chat-pill {
      transition: none;
    }
    html[data-chat='dock'] .chat {
      animation: none;
    }
    .chat-pill-wrap {
      animation: chat-fade 0.4s ease 0.5s forwards;
    }
  }
  @media (forced-colors: active) {
    .chat,
    .chat-pill,
    .chat-pill-x {
      border: 1px solid CanvasText;
      background: Canvas;
      color: CanvasText;
    }
  }
</style>
