---
import { Maximize2, Minimize2, Sparkles, X } from '@lucide/astro';
---

<!-- The chat's static shell. The whole chat is driven by html[data-chat] (open, full, dock; absent means closed), which an
     inline script in Layout sets before the first paint, so a minimised chat is already in place when a new page appears.
     The conversation itself (src/scripts/chat.ts) is fetched only when the chat is used or restored. -->
<div class="chat-pill-wrap">
  <button type="button" class="chat-pill" data-chat-act="open">
    <Sparkles size={16} aria-hidden="true" />
    <span>Ask about Daan</span>
  </button>
  <button type="button" class="chat-pill-x" data-chat-act="dismiss" aria-label="Hide the chat button">
    <X size={12} aria-hidden="true" />
  </button>
</div>

<section id="chat" class="chat" role="dialog" aria-label="Ask about Daan">
  <header class="chat-head">
    <h2 class="chat-title">Ask about Daan</h2>
    <button type="button" class="chat-btn chat-btn-expand" data-chat-act="expand" aria-label="Expand the chat"><Maximize2 size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn chat-btn-min" data-chat-act="minimise" aria-label="Minimise the chat"><Minimize2 size={16} aria-hidden="true" /></button>
    <button type="button" class="chat-btn" data-chat-act="close" aria-label="Close the chat"><X size={16} aria-hidden="true" /></button>
  </header>
  <div class="chat-body"></div>
</section>

<noscript><style>.chat-pill-wrap,.chat-revive{display:none!important}</style></noscript>

<script>
  const root = document.documentElement;
  let chat: Promise<typeof import('../scripts/chat')> | undefined;
  const load = () => (chat ??= import('../scripts/chat'));
  const OFF_KEY = 'chat:off';

  const pill = document.querySelector('.chat-pill');
  pill?.addEventListener('pointerenter', load, { once: true });
  pill?.addEventListener('focus', load, { once: true });

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const button = target.closest<HTMLElement>('[data-chat-act]');
    const act = button?.dataset.chatAct ?? (root.dataset.chat === 'dock' && target.closest('.chat-head') ? 'expand' : '');
    if (!act) return;
    if (act === 'dismiss') {
      try {
        localStorage.setItem(OFF_KEY, String(Date.now()));
      } catch {}
      root.dataset.off = '';
      return;
    }
    if (act === 'revive') {
      try {
        localStorage.removeItem(OFF_KEY);
      } catch {}
      delete root.dataset.off;
    }
    load().then((chat) => chat.act(act === 'revive' ? 'open' : act));
  });

  // A minimised chat from the previous page: bring its conversation back.
  if (root.dataset.chat) load();

  // Back or forward through the browser's cache can show a page frozen in an older chat state.
  addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    let mode: string | undefined;
    try {
      mode = JSON.parse(sessionStorage.getItem('chat:v1') ?? 'null')?.mode;
    } catch {}
    if (mode === 'dock') root.dataset.chat = 'dock';
    else delete root.dataset.chat;
    if (chat || mode === 'dock') load().then((chat) => chat.sync());
  });
</script>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.15s;
  }
  html[data-chat='dock'] .chat {
    view-transition-name: chat;
  }

  .chat {
    --c-bg: #fff;
    --c-fg: #111827;
    --c-muted: #4b5563;
    --c-line: #e5e7eb;
    --c-bubble: #f3f4f6;
    --c-accent: #0f766e;
    --ease: cubic-bezier(0.22, 0.8, 0.3, 1);
    position: fixed;
    z-index: 60;
    display: none;
    flex-direction: column;
    overflow: hidden;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    background: var(--c-bg);
    color: var(--c-fg);
    border: 1px solid var(--c-line);
    border-radius: 1.25rem;
    box-shadow:
      0 0 0 1px rgb(45 212 191 / 0.1),
      0 18px 60px -12px rgb(14 116 144 / 0.4),
      0 0 40px -10px rgb(99 102 241 / 0.35);
    transition:
      left 0.55s var(--ease),
      top 0.55s var(--ease),
      width 0.55s var(--ease),
      height 0.55s var(--ease),
      border-radius 0.55s var(--ease);
  }
  @media (prefers-color-scheme: dark) {
    .chat {
      --c-bg: #171717;
      --c-fg: #fff;
      --c-muted: #a3a3a3;
      --c-line: #404040;
      --c-bubble: #262626;
      --c-accent: #5eead4;
    }
  }
  html[data-chat] .chat {
    display: flex;
  }
  html[data-chat='open'] .chat {
    --w: min(34rem, calc(100% - 2rem));
    --h: min(38rem, calc(100dvh - 3rem));
    --x: calc((100% - var(--w)) / 2);
    --y: calc(100dvh - var(--h) - 1.5rem);
    animation: chat-in 0.35s var(--ease);
  }
  html[data-chat='dock'] .chat {
    --w: min(23rem, calc(100% - 2rem));
    --h: min(30rem, calc(100dvh - 2rem));
    --x: calc(100% - var(--w) - 1rem);
    --y: calc(100dvh - var(--h) - 1rem);
  }
  html[data-chat='full'] .chat {
    --c-bg: transparent;
    --c-fg: #e8f6f6;
    --c-muted: #a9c1cc;
    --c-line: rgb(255 255 255 / 0.16);
    --c-bubble: rgb(255 255 255 / 0.09);
    --c-accent: #5eead4;
    --w: 100%;
    --h: 100dvh;
    --x: 0px;
    --y: 0px;
    border-radius: 0;
    border-color: transparent;
    box-shadow: none;
  }
  @media (max-width: 40rem) {
    html[data-chat='dock'] .chat {
      --w: calc(100% - 1.5rem);
      --h: 3.25rem;
      --x: 0.75rem;
      --y: calc(100dvh - 3.25rem - 0.75rem);
    }
    html[data-chat='dock'] .chat-body {
      display: none;
    }
    html[data-chat='open'] .chat {
      --h: calc(100dvh - 1.5rem);
      --y: 0.75rem;
    }
  }
  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex: none;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    min-height: 3.25rem;
  }
  html[data-chat='dock'] .chat-head {
    cursor: pointer;
  }
  .chat-title {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .chat-title::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #2dd4bf;
    box-shadow: 0 0 10px 2px rgb(45 212 191 / 0.7);
  }
  .chat-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--c-muted);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .chat-btn:hover {
    background: var(--c-bubble);
    color: var(--c-fg);
  }
  .chat-btn-expand,
  .chat-btn-min {
    display: none;
  }
  html[data-chat='dock'] .chat-btn-expand,
  html[data-chat='full'] .chat-btn-min {
    display: grid;
  }
  .chat-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .chat :focus-visible,
  .chat-pill-wrap :focus-visible {
    outline: 2px solid #5eead4;
    outline-offset: 2px;
  }

  .chat-pill-wrap {
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    opacity: 0;
    pointer-events: none;
    isolation: isolate;
    animation: chat-fade 0.7s ease 2s forwards;
  }
  html[data-chat] .chat-pill-wrap,
  html[data-off] .chat-pill-wrap {
    display: none;
  }
  @keyframes chat-fade {
    to {
      opacity: 1;
      pointer-events: auto;
    }
  }
  .chat-pill-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: linear-gradient(110deg, #2dd4bf, #6366f1 60%, #22d3ee);
    filter: blur(16px);
    opacity: 0.5;
    animation: chat-breathe 4s ease-in-out infinite alternate;
  }
  .chat-pill-wrap:hover::before {
    opacity: 0.8;
    animation-play-state: paused;
  }
  @keyframes chat-breathe {
    from {
      opacity: 0.3;
      transform: scale(0.96);
    }
    to {
      opacity: 0.62;
      transform: scale(1.05);
    }
  }
  .chat-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(#0b1220, #0b1220) padding-box,
      linear-gradient(110deg, #2dd4bf, #6366f1 60%, #22d3ee) border-box;
    color: #e6fffb;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.2s var(--ease, ease);
  }
  .chat-pill:hover {
    transform: translateY(-2px);
  }
  .chat-pill-x {
    position: absolute;
    right: -0.4rem;
    bottom: -0.5rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.28);
    background: #0b1220;
    color: #cbd5e1;
    cursor: pointer;
  }
  .chat-pill-x:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.6);
  }
  .chat-revive {
    display: none;
  }
  html[data-off]:not([data-chat]) .chat-revive {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-pill-wrap::before {
      animation: none;
    }
    .chat,
    .chat-pill {
      transition: none;
    }
    html[data-chat='open'] .chat {
      animation: none;
    }
  }
  @media (forced-colors: active) {
    .chat-pill-wrap::before {
      display: none;
    }
    .chat,
    .chat-pill,
    .chat-pill-x {
      border: 1px solid CanvasText;
      background: Canvas;
      color: CanvasText;
    }
  }
</style>
