---
import { Building2, ChevronDown } from '@lucide/astro';
import TimelineBullet, { type Bullet } from './TimelineBullet.astro';
import TimelineLinks, { type TimelineLink } from './TimelineLinks.astro';

export interface TimelineItem {
  title: string;
  titleShort?: string;
  badge?: string;
  subtitle: string;
  subtitleShort?: string;
  subtitleUrl?: string;
  description?: string;
  dates: string;
  datesShort?: string;
  location: string;
  locationShort?: string;
  logo?: string;
  logoDark?: string;
  rounded?: boolean;
  bullets?: Bullet[];
  /** Project links shown under the description, optionally with a GitHub star count. */
  links?: TimelineLink[];
  /** Shown under the bullets, for example "Via RYSST" for roles that went through an agency. */
  via?: TimelineLink;
  /** Left off the resume: glows when the section is opened through its anchor link. */
  earlier?: boolean;
}

interface Props {
  heading: string;
  items: TimelineItem[];
  largeBreak?: boolean;
  visibleCount?: number;
  /** Section id. Visiting `#<anchorId>` opens the hidden roles and highlights the `earlier` ones. */
  anchorId?: string;
}

const { heading, items, largeBreak = false, visibleCount = items.length, anchorId } = Astro.props;
const visibleItems = items.slice(0, visibleCount);
const overflowItems = items.slice(visibleCount);
const hasOverflow = overflowItems.length > 0;
---

<section id={anchorId} class="mb-10 scroll-mt-6">
  <h2 class="text-xl font-semibold mb-6">{heading}</h2>
  <ul>
    {visibleItems.map((item, i) => {
      const hasContent = !!(item.description || (item.bullets && item.bullets.length > 0) || (item.links && item.links.length > 0));
      const showBar = i < visibleItems.length - 1;
      const isLastVisible = hasOverflow && i === visibleItems.length - 1;
      const padClass = showBar || hasOverflow ? 'pb-8' : '';
      return (
        <li class={`flex gap-4 relative isolate ${item.earlier ? 'earlier-item' : ''}`} {...(item.earlier ? { 'data-earlier': '' } : {})}>
          <div class="w-10 flex flex-col items-center">
            <div class="w-10 h-10 shrink-0 flex items-center justify-center overflow-hidden">
              {item.logo
                ? item.logoDark
                  ? <>
                      <img data-exp-logo src={item.logo}     alt={item.subtitle} class={`w-full h-full object-contain dark:hidden ${item.rounded ? 'rounded-sm' : ''}`} />
                      <img data-exp-logo src={item.logoDark} alt={item.subtitle} class={`w-full h-full object-contain hidden dark:block ${item.rounded ? 'rounded-sm' : ''}`} />
                    </>
                  : <img data-exp-logo src={item.logo} alt={item.subtitle} class={`w-full h-full object-contain ${item.rounded ? 'rounded-sm' : ''}`} />
                : <Building2 size={20} class="text-gray-500 dark:text-neutral-400" />
              }
            </div>
            <div
              data-exp-bar
              {...(isLastVisible ? { 'data-exp-toggle-bar': '' } : {})}
              class={`w-px bg-gray-200 dark:bg-neutral-700 flex-1 my-1.5 ${showBar ? '' : 'invisible'}`}
              aria-hidden="true"
            ></div>
          </div>
          <div class={`flex-1 min-w-0 ${padClass}`}>
            {hasContent ? (
              <details class="group">
                <summary class="list-none cursor-pointer">
                  <div class="h-10 flex flex-col justify-center">
                    <div class="flex justify-between items-baseline gap-4">
                      <span class="font-medium text-gray-900 dark:text-white flex items-center gap-1.5">
                        {item.titleShort ? <><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.title}</span><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.titleShort}</span></> : item.title}
                        <ChevronDown size={14} class="text-gray-300 dark:text-neutral-600 transition-transform duration-200 group-open:rotate-180 shrink-0 translate-y-px" />
                      </span>
                      <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                        {item.datesShort
                          ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.datesShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.dates}</span></>
                          : item.dates
                        }
                      </span>
                    </div>
                    <div class="flex justify-between items-baseline gap-4 mt-0.5">
                      <span class="text-sm text-gray-600 dark:text-neutral-300">
                        {item.subtitleUrl ? (
                          <a
                            data-exp-link
                            href={item.subtitleUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block py-0.5 -my-0.5 underline decoration-dotted underline-offset-2 decoration-gray-300 dark:decoration-neutral-600 hover:text-gray-900 dark:hover:text-white hover:decoration-solid hover:decoration-gray-500 dark:hover:decoration-neutral-300 focus-visible:text-gray-900 dark:focus-visible:text-white focus-visible:decoration-solid focus-visible:decoration-gray-500 dark:focus-visible:decoration-neutral-300 transition-colors"
                          >{item.subtitleShort
                              ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                              : item.subtitle
                            }</a>
                        ) : (
                          item.subtitleShort
                            ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                            : item.subtitle
                        )}{item.badge && <span class="text-gray-300 dark:text-neutral-600"> · </span>}{item.badge && <span>{item.badge}</span>}
                      </span>
                      <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                        {item.locationShort
                          ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.locationShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.location}</span></>
                          : item.location
                        }
                      </span>
                    </div>
                  </div>
                </summary>
                <div class="exp-fade">
                  <div class="overflow-hidden">
                    <div class="pt-2.5 pb-1 space-y-2.5">
                      {item.description && (
                        <p class="text-sm text-gray-500 dark:text-neutral-400 italic">{item.description}</p>
                      )}
<TimelineLinks links={item.links} />
                      {item.bullets && item.bullets.length > 0 && (
                        <ul class="space-y-2">
                          {item.bullets.map((bullet) => (
                            <TimelineBullet bullet={bullet} />
                          ))}
                        </ul>
                      )}
                      {item.via && <TimelineLinks links={[item.via]} />}
                    </div>
                  </div>
                </div>
              </details>
            ) : (
              <div class="h-10 flex flex-col justify-center">
                <div class="flex justify-between items-baseline gap-4">
                  <span class="font-medium text-gray-900 dark:text-white">
                    {item.titleShort ? <><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.title}</span><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.titleShort}</span></> : item.title}
                  </span>
                  <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                    {item.datesShort
                      ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.datesShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.dates}</span></>
                      : item.dates
                    }
                  </span>
                </div>
                <div class="flex justify-between items-baseline gap-4 mt-0.5">
                  <span class="text-sm text-gray-600 dark:text-neutral-300">
                    {item.subtitleUrl ? (
                      <a
                        data-exp-link
                        href={item.subtitleUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block py-0.5 -my-0.5 underline decoration-dotted underline-offset-2 decoration-gray-300 dark:decoration-neutral-600 hover:text-gray-900 dark:hover:text-white hover:decoration-solid hover:decoration-gray-500 dark:hover:decoration-neutral-300 focus-visible:text-gray-900 dark:focus-visible:text-white focus-visible:decoration-solid focus-visible:decoration-gray-500 dark:focus-visible:decoration-neutral-300 transition-colors"
                      >{item.subtitleShort
                          ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                          : item.subtitle
                        }</a>
                    ) : (
                      item.subtitleShort
                        ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                        : item.subtitle
                    )}{item.badge && <span class="text-gray-300 dark:text-neutral-600"> · </span>}{item.badge && <span>{item.badge}</span>}
                  </span>
                  <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                    {item.locationShort
                      ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.locationShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.location}</span></>
                      : item.location
                    }
                  </span>
                </div>
              </div>
            )}
          </div>
        </li>
      );
    })}

  </ul>

  {hasOverflow && (
    <div data-exp-overflow style="height: 0; overflow-x: visible; overflow-y: clip;">
      <ul>
        {overflowItems.map((item, i) => {
          const hasContent = !!(item.description || (item.bullets && item.bullets.length > 0) || (item.links && item.links.length > 0));
          const showBar = i < overflowItems.length - 1;
          const padClass = 'pb-8';
          return (
            <li class={`flex gap-4 relative isolate ${item.earlier ? 'earlier-item' : ''}`} {...(item.earlier ? { 'data-earlier': '' } : {})}>
              <div class="w-10 flex flex-col items-center">
                <div class="w-10 h-10 shrink-0 flex items-center justify-center overflow-hidden">
                  {item.logo
                    ? item.logoDark
                      ? <>
                          <img data-exp-logo src={item.logo}     alt={item.subtitle} class={`w-full h-full object-contain dark:hidden ${item.rounded ? 'rounded-sm' : ''}`} />
                          <img data-exp-logo src={item.logoDark} alt={item.subtitle} class={`w-full h-full object-contain hidden dark:block ${item.rounded ? 'rounded-sm' : ''}`} />
                        </>
                      : <img data-exp-logo src={item.logo} alt={item.subtitle} class={`w-full h-full object-contain ${item.rounded ? 'rounded-sm' : ''}`} />
                    : <Building2 size={20} class="text-gray-500 dark:text-neutral-400" />
                  }
                </div>
                <div
                  data-exp-bar
                  class={`w-px bg-gray-200 dark:bg-neutral-700 flex-1 my-1.5 ${showBar ? '' : 'invisible'}`}
                  aria-hidden="true"
                ></div>
              </div>
              <div class={`flex-1 min-w-0 ${padClass}`}>
                {hasContent ? (
                  <details class="group">
                    <summary class="list-none cursor-pointer">
                      <div class="h-10 flex flex-col justify-center">
                        <div class="flex justify-between items-baseline gap-4">
                          <span class="font-medium text-gray-900 dark:text-white flex items-center gap-1.5">
                            {item.titleShort ? <><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.title}</span><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.titleShort}</span></> : item.title}
                            <ChevronDown size={14} class="text-gray-300 dark:text-neutral-600 transition-transform duration-200 group-open:rotate-180 shrink-0 translate-y-px" />
                          </span>
                          <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                            {item.datesShort
                              ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.datesShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.dates}</span></>
                              : item.dates
                            }
                          </span>
                        </div>
                        <div class="flex justify-between items-baseline gap-4 mt-0.5">
                          <span class="text-sm text-gray-600 dark:text-neutral-300">
                            {item.subtitleUrl ? (
                              <a
                                data-exp-link
                                href={item.subtitleUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-block py-0.5 -my-0.5 underline decoration-dotted underline-offset-2 decoration-gray-300 dark:decoration-neutral-600 hover:text-gray-900 dark:hover:text-white hover:decoration-solid hover:decoration-gray-500 dark:hover:decoration-neutral-300 focus-visible:text-gray-900 dark:focus-visible:text-white focus-visible:decoration-solid focus-visible:decoration-gray-500 dark:focus-visible:decoration-neutral-300 transition-colors"
                              >{item.subtitleShort
                                  ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                                  : item.subtitle
                                }</a>
                            ) : (
                              item.subtitleShort
                                ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                                : item.subtitle
                            )}{item.badge && <span class="text-gray-300 dark:text-neutral-600"> · </span>}{item.badge && <span>{item.badge}</span>}
                          </span>
                          <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                            {item.locationShort
                              ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.locationShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.location}</span></>
                              : item.location
                            }
                          </span>
                        </div>
                      </div>
                    </summary>
                    <div class="exp-fade">
                      <div class="overflow-hidden">
                        <div class="pt-2.5 pb-1 space-y-2.5">
                          {item.description && (
                            <p class="text-sm text-gray-500 dark:text-neutral-400 italic">{item.description}</p>
                          )}
<TimelineLinks links={item.links} />
                          {item.bullets && item.bullets.length > 0 && (
                            <ul class="space-y-2">
                              {item.bullets.map((bullet) => (
                                <TimelineBullet bullet={bullet} />
                              ))}
                            </ul>
                          )}
                          {item.via && <TimelineLinks links={[item.via]} />}
                        </div>
                      </div>
                    </div>
                  </details>
                ) : (
                  <div class="h-10 flex flex-col justify-center">
                    <div class="flex justify-between items-baseline gap-4">
                      <span class="font-medium text-gray-900 dark:text-white">
                        {item.titleShort ? <><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.title}</span><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.titleShort}</span></> : item.title}
                      </span>
                      <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                        {item.datesShort
                          ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.datesShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.dates}</span></>
                          : item.dates
                        }
                      </span>
                    </div>
                    <div class="flex justify-between items-baseline gap-4 mt-0.5">
                      <span class="text-sm text-gray-600 dark:text-neutral-300">
                        {item.subtitleUrl ? (
                          <a
                            data-exp-link
                            href={item.subtitleUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block py-0.5 -my-0.5 underline decoration-dotted underline-offset-2 decoration-gray-300 dark:decoration-neutral-600 hover:text-gray-900 dark:hover:text-white hover:decoration-solid hover:decoration-gray-500 dark:hover:decoration-neutral-300 focus-visible:text-gray-900 dark:focus-visible:text-white focus-visible:decoration-solid focus-visible:decoration-gray-500 dark:focus-visible:decoration-neutral-300 transition-colors"
                          >{item.subtitleShort
                              ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                              : item.subtitle
                            }</a>
                        ) : (
                          item.subtitleShort
                            ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.subtitleShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.subtitle}</span></>
                            : item.subtitle
                        )}{item.badge && <span class="text-gray-300 dark:text-neutral-600"> · </span>}{item.badge && <span>{item.badge}</span>}
                      </span>
                      <span class="text-sm text-gray-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                        {item.locationShort
                          ? <><span class={largeBreak ? 'min-[750px]:hidden' : 'sm:hidden'}>{item.locationShort}</span><span class={largeBreak ? 'hidden min-[750px]:inline' : 'hidden sm:inline'}>{item.location}</span></>
                          : item.location
                        }
                      </span>
                    </div>
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  )}

  {hasOverflow && (
    <div class="flex justify-center -mt-4 py-2">
      <button
        data-exp-toggle
        class="flex items-center gap-2 text-sm text-gray-500 dark:text-neutral-400 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer"
      >
        <ChevronDown
          data-exp-toggle-chevron
          size={14}
          class="transition-transform duration-300 shrink-0"
        />
        <span data-exp-toggle-label>{overflowItems.length} more</span>
      </button>
    </div>
  )}
</section>

<script>
  import gsap from 'gsap';

  /** Find the logo img that is currently visible (handles dark/light mode swap). */
  function getVisibleLogo(li: HTMLElement): HTMLImageElement | null {
    const imgs = li.querySelectorAll<HTMLImageElement>('[data-exp-logo]');
    for (const img of imgs) {
      if (img.getBoundingClientRect().width > 0) return img;
    }
    return imgs[0] ?? null;
  }

  function spawnParticle(
    src: string,
    originX: number,
    originY: number,
    options?: { size?: number; durationScale?: number }
  ) {
    const size = options?.size ?? 24;
    const durationScale = options?.durationScale ?? 1;
    const el = document.createElement('img');
    el.src = src;
    el.style.cssText = `
      position: fixed;
      left: ${originX}px;
      top: ${originY}px;
      width: ${size}px;
      height: ${size}px;
      object-fit: contain;
      pointer-events: none;
      z-index: 9999;
    `;
    document.body.appendChild(el);

    const angle = Math.random() * Math.PI * 2;
    const dist = 50 + Math.random() * 75;

    gsap.fromTo(
      el,
      { xPercent: -50, yPercent: -50, scale: 0.9, opacity: 0.8 },
      {
        x: Math.cos(angle) * dist,
        y: Math.sin(angle) * dist,
        scale: 0.05,
        opacity: 0,
        rotation: (Math.random() - 0.5) * 400,
        duration: (0.75 + Math.random() * 0.45) * 1.5 * durationScale,
        ease: 'power2.out',
        onComplete: () => el.remove(),
      }
    );
  }

  // Each wave starts lower along the bar than the one before, so the particles trail down it.
  function runExhaust(logo: HTMLImageElement, bar: HTMLElement | null) {
    const src = logo.src;
    const isCern = src.includes('/logos/cern.png');
    const WAVES = 5;
    const INTERVAL_MS = 165;
    const particleOptions = isCern
      ? { size: 34, durationScale: 2 }
      : undefined;

    for (let w = 0; w < WAVES; w++) {
      setTimeout(() => {
        let x: number, y: number;

        if (bar) {
          const r = bar.getBoundingClientRect();
          const progress = w / (WAVES - 1);
          x = r.left + r.width / 2;
          y = r.top + r.height * progress;
        } else {
          const r = logo.getBoundingClientRect();
          x = r.left + r.width / 2;
          y = r.top + r.height / 2;
        }

        const count = w === 0 ? 5 : 3;
        for (let i = 0; i < count; i++) spawnParticle(src, x, y, particleOptions);
      }, w * INTERVAL_MS);
    }
  }

  function spawnDotParticle(originX: number, originY: number) {
    const el = document.createElement('div');
    el.style.cssText = `
      position: fixed;
      left: ${originX}px;
      top: ${originY}px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      color: #9ca3af;
      pointer-events: none;
      z-index: 9999;
    `;
    document.body.appendChild(el);

    const angle = Math.random() * Math.PI * 2;
    const dist = 50 + Math.random() * 75;

    gsap.fromTo(
      el,
      { xPercent: -50, yPercent: -50, scale: 0.9, opacity: 0.8 },
      {
        x: Math.cos(angle) * dist,
        y: Math.sin(angle) * dist,
        scale: 0.05,
        opacity: 0,
        rotation: (Math.random() - 0.5) * 400,
        duration: (0.75 + Math.random() * 0.45) * 1.5,
        ease: 'power2.out',
        onComplete: () => el.remove(),
      }
    );
  }

  function runToggleExhaust(overflowEl: HTMLElement) {
    const WAVES = 5;
    const INTERVAL_MS = 165;
    for (let w = 0; w < WAVES; w++) {
      setTimeout(() => {
        const r = overflowEl.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.bottom;
        const count = w === 0 ? 5 : 3;
        for (let i = 0; i < count; i++) spawnDotParticle(x + (Math.random() - 0.5) * r.width * 0.6, y);
      }, w * INTERVAL_MS);
    }
  }

  // Stores each bar's height in the closed state so the close animation
  // can return to exactly that height rather than collapsing to zero.
  const barBaseHeights = new WeakMap<HTMLElement, number>();

  document.querySelectorAll<HTMLDetailsElement>('details').forEach((details) => {
    const summary = details.querySelector('summary');
    if (!summary) return;

    summary.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof Element && target.closest('[data-exp-link]')) return;

      e.preventDefault();

      const li = details.closest('li');
      if (!li) return;

      const bar     = li.querySelector<HTMLElement>('[data-exp-bar]');
      const content = details.querySelector<HTMLElement>('.exp-fade');

      if (!details.open) {
        // Read the bar's height before the content appears.
        const baseH = bar ? bar.getBoundingClientRect().height : 0;
        if (bar) barBaseHeights.set(bar, baseH);

        details.open = true;

        if (bar) {
          const fullH = bar.getBoundingClientRect().height;
          gsap.fromTo(bar,
            { height: baseH },
            { height: fullH, duration: 0.8, ease: 'power2.inOut', clearProps: 'height' }
          );
        }

        if (content) {
          gsap.from(content, {
            height: 0,
            overflow: 'hidden',
            duration: 0.8,
            ease: 'power2.inOut',
            clearProps: 'height,overflow',
          });
        }

        const logo = getVisibleLogo(li as HTMLElement);
        if (logo) runExhaust(logo, bar);

      } else {
        const baseH = bar ? (barBaseHeights.get(bar) ?? bar.getBoundingClientRect().height) : 0;

        const tl = gsap.timeline({
          onComplete: () => {
            details.open = false;
            if (bar)     gsap.set(bar,     { clearProps: 'height' });
            if (content) gsap.set(content, { clearProps: 'height,overflow' });
          },
        });

        if (content) tl.to(content, { height: 0, overflow: 'hidden', duration: 0.6, ease: 'power2.inOut' }, 0);
        if (bar)     tl.to(bar,     { height: baseH,                  duration: 0.6, ease: 'power2.inOut' }, 0);
      }
    });
  });

  // Lets the hash handler below open a section's hidden roles the same way its button does.
  const sectionOpeners = new WeakMap<HTMLElement, (onDone?: () => void) => void>();

  document.querySelectorAll<HTMLButtonElement>('[data-exp-toggle]').forEach((btn) => {
    const section = btn.closest<HTMLElement>('section');
    if (!section) return;
    const overflow = section.querySelector<HTMLElement>('[data-exp-overflow]');
    const chevron  = btn.querySelector<HTMLElement>('[data-exp-toggle-chevron]');
    const label    = btn.querySelector<HTMLElement>('[data-exp-toggle-label]');
    if (!overflow || !chevron || !label) return;

    const originalLabel = label.textContent ?? '';
    const toggleBar = section.querySelector<HTMLElement>('[data-exp-toggle-bar]');
    let isOpen = false;

    function open(onDone?: () => void) {
      if (!overflow || !chevron || !label) return;
      if (isOpen) {
        onDone?.();
        return;
      }
      gsap.killTweensOf(overflow);
      gsap.killTweensOf(chevron);
      isOpen = true;
      toggleBar?.classList.remove('invisible');
      gsap.set(overflow, { height: 'auto', overflow: 'visible' });
      const targetH = overflow.getBoundingClientRect().height;
      gsap.set(overflow, { height: 0, overflowX: 'visible', overflowY: 'clip' });
      gsap.to(overflow, {
        height: targetH,
        duration: 0.8,
        ease: 'power2.inOut',
        onComplete: () => {
          gsap.set(overflow, { height: 'auto', overflow: 'visible' });
          onDone?.();
        },
      });
      gsap.to(chevron, { rotation: 180, duration: 0.3, ease: 'power2.inOut' });
      label.textContent = 'view less';
      runToggleExhaust(overflow);
    }

    function close() {
      if (!overflow || !chevron || !label) return;
      gsap.killTweensOf(overflow);
      gsap.killTweensOf(chevron);
      isOpen = false;
      toggleBar?.classList.add('invisible');
      const currentH = overflow.getBoundingClientRect().height;
      gsap.set(overflow, { height: currentH, overflowX: 'visible', overflowY: 'clip' });
      gsap.to(overflow, { height: 0, duration: 0.6, ease: 'power2.inOut' });
      gsap.to(chevron, { rotation: 0, duration: 0.3, ease: 'power2.inOut' });
      label.textContent = originalLabel;
    }

    btn.addEventListener('click', () => (isOpen ? close() : open()));
    sectionOpeners.set(section, open);
  });

  // Visiting `#<section id>` (the resume links here) opens the hidden roles, scrolls to the
  // first role left off the resume and lets each of them glow in turn.
  function revealEarlier() {
    const id = location.hash.slice(1);
    if (!id) return;
    const section = document.getElementById(id);
    const open = section && sectionOpeners.get(section);
    if (!section || !open) return;

    const items = [...section.querySelectorAll<HTMLElement>('[data-earlier]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    open(() => {
      items[0]?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      items.forEach((item, i) => {
        item.style.setProperty('--earlier-delay', `${0.35 + i * 0.18}s`);
        item.classList.remove('earlier-glow');
        void item.offsetWidth; // restart the animation if the link is visited again
        item.classList.add('earlier-glow');
      });
    });
  }

  if (document.readyState === 'complete') revealEarlier();
  else window.addEventListener('load', revealEarlier, { once: true });
  window.addEventListener('hashchange', revealEarlier);
</script>

<style>
  .exp-fade {
    opacity: 1;
    transition: opacity 0.8s ease;
  }

  @starting-style {
    .exp-fade {
      opacity: 0;
    }
  }

  /* Highlight for roles left off the resume. Sits behind the row so it never shifts the layout. */
  /* The fill is opaque (the page color plus a faint tint) so it hides the timeline lines behind it. */
  .earlier-item {
    --glow-bg: color-mix(in srgb, white 96%, rgb(17 24 39));
    --glow-ring: rgb(17 24 39 / 0.14);
    --glow-halo: rgb(17 24 39 / 0.2);
  }

  @media (prefers-color-scheme: dark) {
    .earlier-item {
      --glow-bg: color-mix(in srgb, #171717 95%, white);
      --glow-ring: rgb(255 255 255 / 0.2);
      --glow-halo: rgb(255 255 255 / 0.18);
    }
  }

  /* Lowers the row's own timeline line below the fill. The next row's fill covers the part of this
     line that reaches into it, because later rows paint above earlier ones. */
  .earlier-item [data-exp-bar] {
    z-index: -2;
  }

  .earlier-item::before {
    content: '';
    position: absolute;
    inset: -12px -12px 20px -12px;
    z-index: -1;
    border-radius: 0.75rem;
    background: var(--glow-bg);
    opacity: 0;
    pointer-events: none;
  }

  .earlier-item.earlier-glow::before {
    animation: earlier-glow 2.4s ease-out var(--earlier-delay, 0s) forwards;
  }

  @keyframes earlier-glow {
    0% {
      opacity: 0;
      box-shadow: 0 0 0 0 transparent;
    }
    30% {
      opacity: 1;
      box-shadow: 0 0 0 1px var(--glow-ring), 0 0 28px 4px var(--glow-halo);
    }
    100% {
      opacity: 1;
      box-shadow: 0 0 0 1px var(--glow-ring), 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .earlier-item.earlier-glow::before {
      animation: none;
      opacity: 1;
      box-shadow: 0 0 0 1px var(--glow-ring);
    }
  }
</style>
