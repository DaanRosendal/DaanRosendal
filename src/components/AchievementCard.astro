---
import { Play } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'achievements'>;
  // Load the image straight away when the card is at the top of the page.
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
import { resolveAchievementText } from '../lib/marketplace';
import { imageSize } from '../lib/image';

const { title, when, youtube, thumbnail, cardImage } = entry.data;
const { summaryHtml } = await resolveAchievementText(entry);
const local = cardImage ?? thumbnail;
const image = local ?? (youtube ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` : undefined);
const size = local ? await imageSize(local) : undefined;
---

<a
  href={`/achievements/${entry.id}/`}
  class="group flex flex-col rounded-xl border border-gray-200 dark:border-neutral-800 bg-gray-50/60 dark:bg-neutral-800/40 p-4 transition-all duration-200 active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400 dark:focus-visible:outline-neutral-500 hover:-translate-y-0.5 hover:border-gray-300 hover:bg-gray-50 dark:hover:border-neutral-600 dark:hover:bg-neutral-800"
>
  {image && (
    <div class="relative mb-3 aspect-video overflow-hidden rounded-lg bg-gray-100 dark:bg-neutral-800">
      <img src={image} alt="" width={size?.width} height={size?.height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
      {youtube && (
        <span class="absolute inset-0 flex items-center justify-center bg-black/20">
          <Play size={20} fill="currentColor" class="text-white" />
        </span>
      )}
    </div>
  )}
  <h3 class="text-base font-semibold leading-tight underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-gray-400 dark:group-hover:decoration-neutral-500">{title}</h3>
  <p class="mt-1.5 text-xs text-gray-600 dark:text-neutral-300 flex-1" set:html={summaryHtml} />
  <span class="mt-3 text-xs text-gray-500 dark:text-neutral-400">{when}</span>
</a>
