---
import { Play } from '@lucide/astro';
import PhotoViewer from './PhotoViewer.astro';
import { imageSize } from '../lib/image';

interface Photo {
  src: string;
  alt: string;
  full?: string;
  position?: string;
}

interface Props {
  photos: Photo[];
  video?: string;
}

const { photos, video } = Astro.props;
const [lead, ...rest] = photos;
const sizes = await Promise.all(photos.map((photo) => imageSize(photo.src)));
// Every tile has a smaller "-sm" copy for phones: the browser picks the one that fits the tile's width.
const smallSrc = (src: string) => src.replace(/\.webp$/, '-sm.webp');
const smallSizes = await Promise.all(photos.map((photo) => imageSize(smallSrc(photo.src))));
const srcset = (i: number) => smallSizes[i] && sizes[i] ? `${smallSrc(photos[i].src)} ${smallSizes[i]!.width}w, ${photos[i].src} ${sizes[i]!.width}w` : undefined;
// Tile width: a quarter of the four-column grid, which is at most 720px wide. The lead photo spans two columns.
const tileWidth = 'calc((min(100vw, 768px) - 72px) / 4)';
const leadWidth = 'calc((min(100vw, 768px) - 72px) / 2 + 8px)';
// A single photo, often a portrait, floats beside the text instead of forming a collage.
const single = photos.length === 1 && !video;
const tileBase = 'group relative block overflow-hidden rounded-lg bg-gray-100 dark:bg-neutral-800';
const tile = `${tileBase} aspect-[3/2]`;
const img = 'w-full h-full object-cover transition-transform duration-300 group-hover:scale-105';
---

{single ? (
  <a
    href={lead.full ?? lead.src}
    data-lightbox="0"
    target="_blank"
    rel="noopener noreferrer"
    class="group relative mx-auto mb-6 block w-full max-w-60 overflow-hidden rounded-lg bg-gray-100 dark:bg-neutral-800 md:float-right md:mb-4 md:ml-8 md:w-60"
  >
    <img src={lead.src} alt={lead.alt} width={sizes[0]?.width} height={sizes[0]?.height} loading="eager" fetchpriority="high" decoding="async" class="block h-auto w-full transition-transform duration-300 group-hover:scale-105" />
  </a>
) : (
<div class="grid grid-cols-4 gap-2">
  <a href={lead.full ?? lead.src} data-lightbox="0" target="_blank" rel="noopener noreferrer" class={`${tileBase} col-span-2 row-span-2`}>
    <img src={lead.src} alt={lead.alt} srcset={srcset(0)} sizes={leadWidth} width={sizes[0]?.width} height={sizes[0]?.height} loading="eager" fetchpriority="high" decoding="async" class={`${img} absolute inset-0`} style={lead.position && `object-position: ${lead.position}`} />
  </a>
  {rest.map((photo, i) => (
    <a href={photo.full ?? photo.src} data-lightbox={i + 1} target="_blank" rel="noopener noreferrer" class={tile}>
      <img src={photo.src} alt={photo.alt} srcset={srcset(i + 1)} sizes={tileWidth} width={sizes[i + 1]?.width} height={sizes[i + 1]?.height} loading="lazy" decoding="async" class={img} style={photo.position && `object-position: ${photo.position}`} />
    </a>
  ))}
  {video && (
    <a
      href={`https://youtu.be/${video}`}
      data-lightbox={photos.length}
      data-video={video}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Watch the demo video on YouTube"
      class={tile}
    >
      <img src={`https://i.ytimg.com/vi/${video}/hqdefault.jpg`} alt="" loading="lazy" class={img} />
      <span class="absolute inset-0 flex items-center justify-center bg-black/30">
        <Play size={18} fill="currentColor" class="text-white" />
      </span>
    </a>
  )}
</div>
)}

<PhotoViewer />
