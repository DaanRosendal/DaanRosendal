// resume link (see revealEarlier in TimelineList.astro). It runs from the left edge of the logos to the
// right edge of the dates and locations, so it lines up with the row content and not with the highlight.
---

<li data-earlier-divider hidden class="flex items-center gap-3 pb-5 text-xs text-gray-500 dark:text-neutral-400">
  <span class="h-px flex-1 bg-gray-200 dark:bg-neutral-700" aria-hidden="true"></span>
  <span>Not on the resume</span>
  <span class="h-px flex-1 bg-gray-200 dark:bg-neutral-700" aria-hidden="true"></span>
</li>
