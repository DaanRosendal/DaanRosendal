---
import { MessageCircle } from '@lucide/astro';
---

<button type="button" data-ask-open class="flex items-center gap-1.5 cursor-pointer hover:text-gray-900 dark:hover:text-white transition-colors max-sm:basis-full max-sm:justify-center max-sm:mt-3 max-sm:py-2 max-sm:rounded-full max-sm:border max-sm:border-gray-300 dark:max-sm:border-neutral-600">
  <MessageCircle size={14} />
  <span>Ask about Daan</span>
</button>
<noscript><style>[data-ask-open]{display:none}</style></noscript>

<script>
  // The chat itself (about 8 kB) is fetched on the first hover, focus or click, not with the page.
  const button = document.querySelector<HTMLButtonElement>('[data-ask-open]');
  let chat: Promise<typeof import('../scripts/chat')> | undefined;
  const load = () => (chat ??= import('../scripts/chat'));
  button?.addEventListener('pointerenter', load, { once: true });
  button?.addEventListener('focus', load, { once: true });
  button?.addEventListener('click', async () => (await load()).openChat());
</script>

<style is:global>
  .ask-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    width: min(34rem, calc(100vw - 2rem));
    height: min(38rem, calc(100dvh - 2rem));
    max-height: none;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #fff;
    color: #111827;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.18);
    overflow: hidden;
  }
  .ask-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .ask-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .ask-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem 0.25rem 1.25rem;
  }
  .ask-title {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .ask-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #4b5563;
  }
  .ask-close:hover {
    background: #f3f4f6;
    color: #111827;
  }
  .ask-note,
  .ask-foot {
    padding: 0 1.25rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #6b7280;
  }
  .ask-foot {
    padding-bottom: 0.75rem;
  }
  .ask-log {
    border-top: 1px solid #e5e7eb;
    margin-top: 0.5rem;
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    font-size: 0.925rem;
    line-height: 1.5;
  }
  .ask-msg {
    max-width: 90%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ask-user {
    align-self: flex-end;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    background: #f3f4f6;
  }
  .ask-notice {
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px dashed #d1d5db;
    font-size: 0.85rem;
    color: #4b5563;
  }
  .ask-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ask-chip {
    cursor: pointer;
    padding: 0.375rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 0.825rem;
    color: #374151;
    text-align: left;
  }
  .ask-chip:hover {
    border-color: #6b7280;
    color: #111827;
  }
  .ask-link {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }
  .ask-link:hover {
    text-decoration-style: solid;
  }
  .ask-turnstile:empty {
    display: none;
  }
  .ask-turnstile {
    padding: 0 1.25rem 0.5rem;
  }
  .ask-form {
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
    padding: 0.5rem 1.25rem 0.5rem;
  }
  .ask-input {
    flex: 1;
    resize: none;
    overflow-y: hidden;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.925rem;
    line-height: 1.4;
  }
  .ask-input::placeholder {
    color: #6b7280;
  }
  .ask-send {
    cursor: pointer;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: #111827;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .ask-send:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .ask-dialog :focus-visible {
    outline: 2px solid #6b7280;
    outline-offset: 2px;
  }
  @media (prefers-color-scheme: dark) {
    .ask-dialog {
      background: #171717;
      color: #fff;
      border-color: #404040;
    }
    .ask-close {
      color: #d4d4d4;
    }
    .ask-close:hover {
      background: #262626;
      color: #fff;
    }
    .ask-note,
    .ask-foot,
    .ask-input::placeholder {
      color: #a3a3a3;
    }
    .ask-log {
      border-top-color: #404040;
    }
    .ask-user {
      background: #262626;
    }
    .ask-notice {
      border-color: #525252;
      color: #d4d4d4;
    }
    .ask-chip {
      border-color: #525252;
      color: #d4d4d4;
    }
    .ask-chip:hover {
      border-color: #a3a3a3;
      color: #fff;
    }
    .ask-input {
      border-color: #525252;
    }
    .ask-send {
      background: #fff;
      color: #171717;
    }
    .ask-dialog :focus-visible {
      outline-color: #a3a3a3;
    }
  }
</style>
