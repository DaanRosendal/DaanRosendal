---
import { getCollection, type CollectionEntry } from 'astro:content';
import HighlightCard from './HighlightCard.astro';
import LiveCounts from './LiveCounts.astro';
import { tracks } from '../lib/highlights';

// 'importance' sorts by each entry's `order` (lowest first).
// 'date' sorts newest first by `date`, with undated entries last, falling back to `order`.
const SORT_BY: 'importance' | 'date' = 'importance';

const byImportance = (a: Entry, b: Entry) => a.data.order - b.data.order;
const byDate = (a: Entry, b: Entry) =>
  (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity) || byImportance(a, b);

type Entry = CollectionEntry<'highlights'>;
const entries = (await getCollection('highlights')).sort(SORT_BY === 'date' ? byDate : byImportance);

---

<section class="tracks mb-14 grid gap-10 min-[480px]:grid-cols-2 min-[480px]:gap-x-4 min-[680px]:grid-cols-3 min-[680px]:gap-5" data-nosnippet>
  {tracks.map(({ id, label }) => {
    const items = entries.filter((e) => e.data.track === id);
    return items.length > 0 && (
      <div>
        <h2 class="mb-3 text-center text-lg font-semibold">{label}</h2>
        <div class="cards grid gap-3">
          {items.map((entry, index) => <HighlightCard entry={entry} priority={index === 0} />)}
        </div>
      </div>
    );
  })}
</section>

<LiveCounts />

<style>
  /* With two columns, a lone last track spans both and lays its cards side by side. */
  @media (min-width: 480px) and (max-width: 679px) {
    .tracks > :nth-child(odd):last-child {
      grid-column: span 2;
    }
    .tracks > :nth-child(odd):last-child .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }
</style>
