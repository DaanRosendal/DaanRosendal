---
import Layout from '../layouts/Layout.astro';
import { Images, X } from '@lucide/astro';
import { join } from 'node:path';
import sharp from 'sharp';

// The photos are 540 x 720 (3:4), cropped from the originals with metadata stripped. `rot` is the tilt each photo has before the script takes over (and without JavaScript).
const cats = [
  { src: 'belly', rot: -3, alt: 'My tabby cat lying on his back on a wooden floor, looking up at the camera' },
  { src: 'cap', rot: 2.5, alt: 'My cat in his cat-tree bed, wearing a beige baseball cap and looking unimpressed' },
  { src: 'tower', rot: -1.5, alt: 'My cat resting on top of his cat tree with his paws hanging down, under a garland of holly leaves' },
  { src: 'tree', rot: 3.5, alt: 'My cat standing on a tree branch in a sunny park, on a harness and leash' },
  { src: 'bath', rot: -2.5, alt: 'My cat sprawled in the bathtub with one leg stretched out and his tail curled' },
  { src: 'flowers', rot: 1.5, alt: 'My cat sitting on a shelf next to a vase of red carnations, looking up at them' },
  { src: 'backpack', rot: -3.5, alt: 'My cat peeking out of a pet backpack on the grass in a sunny park' },
  { src: 'bowl', rot: 2, alt: 'My cat eating from a bowl on my desk, next to a chocolate protein drink' },
];

// Four corner colors per photo, sampled at build time, feed the glow behind the pile (no image is loaded for it).
const glow = await Promise.all(
  cats.map(async (cat) => {
    const { data } = await sharp(join(process.cwd(), 'public/media/cat', `${cat.src}.webp`))
      .resize(2, 2, { fit: 'fill' })
      .removeAlpha()
      .raw()
      .toBuffer({ resolveWithObject: true });
    return [0, 1, 2, 3].map((i) => `rgb(${data[i * 3]} ${data[i * 3 + 1]} ${data[i * 3 + 2]})`).join('|');
  }),
);
---
<Layout title="Page not found - Daan Rosendal" description="This page does not exist." noindex chat={false}>
  <!-- Everything scales with the window height so the page fits without scrolling: 6rem is the body's vertical padding in Layout.astro (py-12), and the 19rem in --sh below is the room the heading, the text and the button row take. Change either and re-check the fit. -->
  <div class="flex min-h-[calc(100svh-6rem)] flex-col items-center justify-center text-center" style="--f: clamp(4.5rem, 16svh, 11rem)">
    <h1 class="sr-only">404 - Page not found</h1>

    <!-- The three letters fall and can be dragged and thrown (src/scripts/fall-404.ts). Without JavaScript, or with reduced motion, they sit still in a row. -->
    <div id="stage" aria-hidden="true" class="relative mx-auto flex w-full max-w-md items-end justify-center gap-1 select-none" style="height: calc(var(--f) * 1.3)">
      <span data-letter class="block leading-none font-bold" style="font-size: var(--f)">4</span>
      <span data-letter class="block leading-none font-bold" style="font-size: var(--f)">0</span>
      <span data-letter class="block leading-none font-bold" style="font-size: var(--f)">4</span>
    </div>

    <h2 class="mt-6 text-2xl font-bold">Nothing here but my cat.</h2>
    <p class="mt-2 text-gray-700 dark:text-neutral-300">He insisted on being the 404 page.</p>

    <!-- A pile of photos (src/scripts/cat-stack.ts). Without JavaScript the pile just sits there. -->
    <div
      id="cats"
      role="group"
      aria-label="Photos of my cat"
      class="relative mx-auto mt-8 select-none"
      style="--sh: clamp(9rem, calc(100svh - var(--f) * 1.3 - 19rem), 24rem); height: var(--sh); width: calc(var(--sh) * 0.75)"
    >
      <div id="cat-glow" aria-hidden="true" class="pointer-events-none absolute -inset-8 z-0">
        <div class="absolute inset-0 rounded-3xl"></div>
        <div class="absolute inset-0 rounded-3xl"></div>
      </div>
      {cats.map((cat, i) => (
        <figure
          data-card={i}
          data-glow={glow[i]}
          class="absolute inset-0 m-0 rounded-md bg-neutral-50 p-2 shadow-xl shadow-black/25"
          style={`transform: rotate(${cat.rot}deg); z-index: ${cats.length - i}`}
        >
          <img
            src={`/media/cat/${cat.src}.webp`}
            alt={cat.alt}
            width="540"
            height="720"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
            draggable="false"
            class="pointer-events-none block h-full w-full rounded-sm object-cover"
          />
          <span class="glare" aria-hidden="true"></span>
        </figure>
      ))}
    </div>

    <p id="cat-status" class="sr-only" aria-live="polite"></p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <p id="cat-count" aria-hidden="true" class="text-sm text-gray-500 tabular-nums dark:text-neutral-400">1 / {cats.length}</p>
      <button
        id="cat-fan"
        type="button"
        aria-pressed="false"
        aria-label="Fan out the photos"
        title="Fan out the photos"
        class="group hidden size-11 touch-manipulation items-center justify-center rounded-full border border-gray-300 text-gray-700 transition-[transform,background-color,color,border-color] duration-150 [-webkit-tap-highlight-color:transparent] hover:border-gray-500 hover:text-gray-900 active:scale-90 active:bg-gray-100 aria-pressed:border-gray-900 aria-pressed:bg-gray-900 aria-pressed:text-white dark:border-neutral-600 dark:text-neutral-300 dark:hover:border-neutral-400 dark:hover:text-white dark:active:bg-neutral-800 dark:aria-pressed:border-white dark:aria-pressed:bg-white dark:aria-pressed:text-neutral-900"
      >
        <Images size={18} class="group-aria-pressed:hidden" />
        <X size={18} class="hidden group-aria-pressed:block" />
      </button>
      <span class="text-gray-300 dark:text-neutral-600" aria-hidden="true">·</span>
      <a href="/" class="text-gray-700 underline decoration-gray-300 underline-offset-2 hover:decoration-current dark:text-neutral-300 dark:decoration-neutral-600">Back to the home page</a>
    </div>
  </div>
</Layout>

<style is:global>
  /* Photos and letters fly past the edge of the window, so never show a horizontal scrollbar. */
  html { overflow-x: clip; }
  /* A photo flicked down must not make the page scrollable. The body is exactly one window tall here, so this clips at the window edge. */
  body { overflow-y: clip; }

  /* Hide the letters until the script has placed them, so they do not flash at the bottom before they fall. Without JavaScript they stay visible. */
  @media (scripting: enabled) {
    #stage:not([data-ready]) [data-letter] { visibility: hidden; }
  }
  /* Only once the physics is running are the letters grabbable. */
  #stage[data-live] [data-letter] { cursor: grab; touch-action: none; }
  #stage[data-live] [data-letter][data-held] { cursor: grabbing; }

  /* The fan button only makes sense with JavaScript. */
  @media (scripting: enabled) {
    #cat-fan { display: inline-flex; }
  }

  /* The photos start hidden and are dealt in by the script. Without JavaScript the pile stays visible. */
  @media (scripting: enabled) {
    #cats:not([data-ready]) [data-card] { visibility: hidden; }
  }
  /* The pile claims every touch gesture, so a swipe in any direction moves the photo instead of scrolling the page. */
  #cats { touch-action: none; transition: margin-bottom 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
  #cats[data-ready] { cursor: pointer; }
  #cats[data-fan] { cursor: default; }
  #cats:focus-visible { outline: 2px solid currentColor; outline-offset: 12px; border-radius: 0.5rem; }
  /* A springy settle: the cards overshoot a little and bounce into place. Keep SPRING_MS in cat-stack.ts in step with the 0.9s. */
  #cats [data-card] {
    transition: transform 0.9s cubic-bezier(0.34, 1.45, 0.64, 1), opacity 0.5s ease;
    will-change: transform;
  }
  /* In the fan, the photo under the cursor lifts smoothly (the pile order never changes, so nothing snaps). The invisible margin keeps the hover steady while the photo moves. */
  #cats[data-fan] [data-card] {
    cursor: pointer;
    transition: transform 0.9s cubic-bezier(0.34, 1.45, 0.64, 1), translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), scale 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease;
  }
  #cats[data-fan] [data-card]::after { content: ''; position: absolute; inset: -12px 0; }
  #cats[data-fan] [data-card]:hover { translate: 0 -10px; scale: 1.04; }

  /* Light that follows the cursor across the top photo. */
  #cats .glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.7), rgb(255 255 255 / 0) 55%);
    mix-blend-mode: overlay;
  }
  #cats [data-card][data-tilt] .glare { opacity: 1; }

  /* The glow behind the pile: a blurred copy of the current photo. */
  #cat-glow > div { opacity: 0; filter: blur(44px) saturate(2.6); transition: opacity 1s ease; }
  #cat-glow > div[data-on] { opacity: 0.45; }
  @media (prefers-color-scheme: dark) {
    #cat-glow > div[data-on] { opacity: 0.6; }
  }

  @media (prefers-reduced-motion: reduce) {
    #cats, #cats [data-card], #cats[data-fan] [data-card], #cat-glow > div { transition: none; }
  }
</style>

<script>
  import { fall } from '../scripts/fall-404';
  import { catStack } from '../scripts/cat-stack';

  const byId = (id: string) => document.getElementById(id);
  const stage = byId('stage');
  const stack = byId('cats');
  if (stage) fall(stage);
  if (stack) catStack({ stack, counter: byId('cat-count'), fanButton: byId('cat-fan'), glow: byId('cat-glow'), status: byId('cat-status') });
</script>
